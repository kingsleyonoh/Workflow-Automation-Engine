# Server
HOST=0.0.0.0
PORT=8000
ENV=development
LOG_LEVEL=info

# Tenant Management
SELF_REGISTRATION_ENABLED=true
DEFAULT_TENANT_NAME=Default

# Database
DATABASE_URL=postgresql+asyncpg://postgres:devpass@localhost:5435/workflows
TEST_DATABASE_URL=postgresql+asyncpg://postgres:devpass@localhost:5435/workflows_test
REDIS_URL=redis://localhost:6380

# Execution
MAX_STEPS_PER_WORKFLOW=50
MAX_CONCURRENT_STEPS=10
EXECUTION_TIMEOUT_SECONDS=300
HTTP_STEP_TIMEOUT=30
MAX_RESPONSE_BODY_SIZE=1048576
MAX_SUB_WORKFLOW_DEPTH=3

# Webhooks
MAX_PAYLOAD_SIZE=1048576
WEBHOOK_REPLAY_ENABLED=true

# Scheduler
CRON_TIMEZONE=UTC
MAX_CRON_WORKFLOWS=50

# Workers
ARQ_CONCURRENCY=10
ARQ_MAX_JOBS=100
