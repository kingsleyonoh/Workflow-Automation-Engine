# Production Environment Variables
# Copy to .env and fill in real values before deploying.

# Server
HOST=0.0.0.0
PORT=8000
ENV=production
LOG_LEVEL=info

# Tenant Management
SELF_REGISTRATION_ENABLED=true
DEFAULT_TENANT_NAME=Default

# Database (internal Docker network hostnames)
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/workflows
REDIS_URL=redis://redis:6379

# PostgreSQL container password (used by docker-compose.prod.yml)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Execution
MAX_STEPS_PER_WORKFLOW=50
MAX_CONCURRENT_STEPS=10
EXECUTION_TIMEOUT_SECONDS=300
HTTP_STEP_TIMEOUT=30
MAX_RESPONSE_BODY_SIZE=1048576
MAX_SUB_WORKFLOW_DEPTH=3

# Webhooks
MAX_PAYLOAD_SIZE=1048576
WEBHOOK_REPLAY_ENABLED=true

# Scheduler
CRON_TIMEZONE=UTC
MAX_CRON_WORKFLOWS=50

# Workers
ARQ_CONCURRENCY=10
ARQ_MAX_JOBS=100
